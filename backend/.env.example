# =============================================================================
# Smart Farming Assistant - Backend Configuration
# =============================================================================

# Sarvam AI API Configuration
# Get your API key from https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# Sarvam Model Identifiers (Speech-to-Text and Text-to-Speech)
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# Translation & NLP Processing Mode:
# "sarvam"  - Real live Sarvam AI API calls for Hindi (hi-IN) and Kannada (kn-IN)
# "mock"    - Deterministic local mock responses for offline testing
TRANSLATION_MODE=sarvam

# Voice STT / TTS Mode:
# "sarvam"  - Real Sarvam Saarika (STT) and Bulbul (TTS) models
# "mock"    - Synthetic test audio and transcripts for development
VOICE_MODE=sarvam

# Whisper STT Fallback:
# "true"    - Enable Whisper as fallback when Sarvam fails or for non-Sarvam audio
# "false"   - Return clear error if Sarvam STT fails
ENABLE_WHISPER_FALLBACK=true
WHISPER_MODEL_NAME=openai/whisper-tiny

# Hugging Face Model Names:
HF_INTENT_MODEL=valhalla/distilbart-mnli-12-1
HF_NER_MODEL=dslim/bert-base-NER

# Server Configuration:
PORT=6000
HOST=127.0.0.1

# =============================================================================
# Security & Rate Limiting Configuration (Milestone 3 – Part 2)
# =============================================================================

# Secret key used for signing RFC 7519 JWT access tokens (HS256)
# MANDATORY IN PRODUCTION: Must be at least 32 characters and NOT a default placeholder.
# In production, startup is aborted if this key is missing or weak (e.g. generate via `openssl rand -hex 32`).
JWT_SECRET_KEY=farmsaathi-secure-default-jwt-secret-key-change-in-production-2026

# Administrator Bootstrap Key (used to securely initialize the first admin account via /auth/bootstrap-admin)
ADMIN_BOOTSTRAP_KEY=your_secure_admin_bootstrap_secret_key_here

# JWT access token lifetime in minutes (default: 60)
JWT_DEFAULT_EXPIRY_MINUTES=60

# Maximum character length for incoming farmer questions (default: 1500)
MAX_QUESTION_LENGTH=1500

# Rate limiting thresholds (sliding 60-second window)
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_SESSION_PER_MINUTE=60

# Persistent SQLite database path for farmer sessions and user accounts
FARM_SESSIONS_DB_PATH=data/farm_sessions.db

